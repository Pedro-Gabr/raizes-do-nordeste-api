                  "message": "Token não informado.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/fidelidade/saldo"
                }
              }
            }
          },
          "500": {
            "description": "Erro ao consultar pontos.",
            "content": {
              "application/json": {
                "example": {
                  "error": "ERRO_INTERNO",
                  "message": "Erro ao consultar pontos.",
                  "details": [],
