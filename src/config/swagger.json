{
  "openapi": "3.0.3",
  "info": {
    "title": "API Raízes do Nordeste",
    "version": "1.0.0",
    "description": "Documentação das rotas implementadas. Os IDs e as datas mostrados nos exemplos são ilustrativos. Recursos como histórico e resgate de pontos ainda estão em desenvolvimento."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Autenticação",
      "description": "Cadastro e login"
    },
    {
      "name": "Loja",
      "description": "Unidades, produtos e estoque"
    },
    {
      "name": "Pedidos",
      "description": "Criação e acompanhamento de pedidos"
    },
    {
      "name": "Pagamentos",
      "description": "Pagamento simulado (mock)"
    },
    {
      "name": "Fidelidade",
      "description": "Consulta de pontos"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Informe o token retornado em POST /auth/login."
      }
    }
  },
  "paths": {
    "/auth/cadastro": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Cadastrar cliente",
        "description": "O cadastro público sempre cria a conta com perfil CLIENTE, mesmo se outro perfil for enviado no corpo da requisição. O consentimento é registrado como booleano.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "senha": {
                    "type": "string",
                    "minLength": 6
                  },
                  "consentimentoLGPD": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "nome",
                  "email",
                  "senha"
                ]
              },
              "example": {
                "nome": "Maria Silva",
                "email": "maria@teste.com",
                "senha": "123456",
                "consentimentoLGPD": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conta cadastrada",
            "content": {
              "application/json": {
                "example": {
                  "msg": "Usuário criado com sucesso",
                  "dados": {
                    "id": "11111111-1111-4111-8111-111111111111",
                    "nome": "Maria Silva",
                    "email": "maria@teste.com",
                    "role": "CLIENTE",
                    "pontos": 0,
                    "consentimentoLGPD": true,
                    "consentimentoEm": null,
                    "anonimizadoEm": null,
                    "criadoEm": "2026-11-21T12:00:00.000Z"
                  }
                }
              }
            }
          },
          "409": {
            "description": "Este e-mail já está cadastrado.",
            "content": {
              "application/json": {
                "example": {
                  "error": "EMAIL_DUPLICADO",
                  "message": "Este e-mail já está cadastrado.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/auth/cadastro"
                }
              }
            }
          },
          "422": {
            "description": "Informe um e-mail válido.",
            "content": {
              "application/json": {
                "example": {
                  "error": "EMAIL_INVALIDO",
                  "message": "Informe um e-mail válido.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/auth/cadastro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno no servidor.",
            "content": {
              "application/json": {
                "example": {
                  "error": "ERRO_INTERNO",
                  "message": "Erro interno no servidor.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/auth/cadastro"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Fazer login e obter token JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "senha": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "senha"
                ]
              },
              "example": {
                "email": "pedro@teste.com",
                "senha": "123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado",
            "content": {
              "application/json": {
                "example": {
                  "accessToken": "SEU_TOKEN_JWT",
                  "tokenType": "Bearer",
                  "expiresIn": 86400,
                  "user": {
                    "id": "11111111-1111-4111-8111-111111111111",
                    "nome": "Pedro Cliente",
                    "perfil": "CLIENTE"
                  }
                }
              }
            }
          },
          "401": {
            "description": "E-mail ou senha inválidos.",
            "content": {
              "application/json": {
                "example": {
                  "error": "CREDENCIAIS_INVALIDAS",
                  "message": "E-mail ou senha inválidos.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/auth/login"
                }
              }
            }
          },
          "422": {
            "description": "Informe e-mail e senha.",
            "content": {
              "application/json": {
                "example": {
                  "error": "CAMPOS_OBRIGATORIOS",
                  "message": "Informe e-mail e senha.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/auth/login"
                }
              }
            }
          },
          "500": {
            "description": "Erro ao realizar login.",
            "content": {
              "application/json": {
                "example": {
                  "error": "ERRO_INTERNO",
                  "message": "Erro ao realizar login.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/auth/login"
                }
              }
            }
          }
        }
      }
    },
    "/unidades": {
      "get": {
        "tags": [
          "Loja"
        ],
        "summary": "Listar unidades",
        "responses": {
          "200": {
            "description": "Unidades cadastradas",
            "content": {
              "application/json": {
                "example": [
                  {
                    "id": "33333333-3333-4333-8333-333333333333",
                    "nome": "Raízes - Shopping Recife",
                    "endereco": "Av. Padre Carapuceiro, 777 - Recife/PE"
                  }
                ]
              }
            }
          },
          "500": {
            "description": "Erro ao listar unidades.",
            "content": {
              "application/json": {
                "example": {
                  "error": "ERRO_INTERNO",
                  "message": "Erro ao listar unidades.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/unidades"
                }
              }
            }
          }
        }
      }
    },
    "/unidades/{id}/cardapio": {
      "get": {
        "tags": [
          "Loja"
        ],
        "summary": "Consultar o cardápio de uma unidade",
        "description": "Rota pública. Lista os produtos ativos que têm saldo em estoque na unidade, em ordem alfabética. Produto sem estoque ou desativado não aparece. A listagem ainda não tem paginação.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID da unidade",
            "example": "33333333-3333-4333-8333-333333333333"
          }
        ],
        "responses": {
          "200": {
            "description": "Cardápio da unidade",
            "content": {
              "application/json": {
                "example": [
                  {
                    "id": "55555555-5555-4555-8555-555555555555",
                    "nome": "Cuscuz Recheado",
                    "preco": 12,
                    "descricao": "Cuscuz nordestino com queijo coalho e manteiga de garrafa"
                  },
                  {
                    "id": "44444444-4444-4444-8444-444444444444",
                    "nome": "Tapioca de Carne de Sol",
                    "preco": 15.5,
                    "descricao": "Tapioca artesanal com carne de sol na nata"
                  }
                ]
              }
            }
          },
          "404": {
            "description": "Unidade informada não existe.",
            "content": {
              "application/json": {
                "example": {
                  "error": "UNIDADE_NAO_ENCONTRADA",
                  "message": "Unidade informada não existe.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/unidades/33333333-3333-4333-8333-333333333333/cardapio"
                }
              }
            }
          },
          "500": {
            "description": "Erro ao consultar cardápio.",
            "content": {
              "application/json": {
                "example": {
                  "error": "ERRO_INTERNO",
                  "message": "Erro ao consultar cardápio.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/unidades/33333333-3333-4333-8333-333333333333/cardapio"
                }
              }
            }
          }
        }
      }
    },
    "/produtos": {
      "get": {
        "tags": [
          "Loja"
        ],
        "summary": "Listar produtos disponíveis",
        "description": "A listagem atual retorna todos os produtos marcados como disponíveis; ainda não oferece paginação ou filtro por unidade.",
        "responses": {
          "200": {
            "description": "Lista de produtos",
            "content": {
              "application/json": {
                "example": [
                  {
                    "id": "44444444-4444-4444-8444-444444444444",
                    "nome": "Tapioca de Carne de Sol",
                    "preco": 15.5,
                    "descricao": "Tapioca artesanal com carne de sol na nata",
                    "disponivel": true
                  }
                ]
              }
            }
          },
          "500": {
            "description": "Erro ao listar produtos.",
            "content": {
              "application/json": {
                "example": {
                  "error": "ERRO_INTERNO",
                  "message": "Erro ao listar produtos.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/produtos"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Loja"
        ],
        "summary": "Cadastrar produto",
        "description": "Apenas o perfil GERENTE pode cadastrar produtos.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string"
                  },
                  "preco": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "descricao": {
                    "type": "string",
                    "nullable": true
                  }
                },
                "required": [
                  "nome",
                  "preco"
                ]
              },
              "example": {
                "nome": "Tapioca de Carne de Sol",
                "preco": 15.5,
                "descricao": "Tapioca artesanal com carne de sol na nata"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produto cadastrado",
            "content": {
              "application/json": {
                "example": {
                  "id": "44444444-4444-4444-8444-444444444444",
                  "nome": "Tapioca de Carne de Sol",
                  "preco": 15.5,
                  "descricao": "Tapioca artesanal com carne de sol na nata",
                  "disponivel": true
                }
              }
            }
          },
          "401": {
            "description": "Token não informado.",
            "content": {
              "application/json": {
                "example": {
                  "error": "NAO_AUTENTICADO",
                  "message": "Token não informado.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/produtos"
                }
              }
            }
          },
          "403": {
            "description": "Seu perfil não tem acesso a este recurso.",
            "content": {
              "application/json": {
                "example": {
                  "error": "SEM_PERMISSAO",
                  "message": "Seu perfil não tem acesso a este recurso.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/produtos"
                }
              }
            }
          },
          "422": {
            "description": "Nome e preço positivo são obrigatórios.",
            "content": {
              "application/json": {
                "example": {
                  "error": "DADOS_INVALIDOS",
                  "message": "Nome e preço positivo são obrigatórios.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/produtos"
                }
              }
            }
          },
          "500": {
            "description": "Erro ao cadastrar produto.",
            "content": {
              "application/json": {
                "example": {
                  "error": "ERRO_INTERNO",
                  "message": "Erro ao cadastrar produto.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/produtos"
                }
              }
            }
          }
        }
      }
    },
    "/estoque": {
      "post": {
        "tags": [
          "Loja"
        ],
        "summary": "Registrar entrada de estoque",
        "description": "Apenas o perfil GERENTE pode registrar entradas. A quantidade é somada ao estoque da unidade; se o produto ainda não tinha estoque nela, o estoque é criado com a quantidade informada. A ação fica registrada na auditoria.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "unidadeId": {
                    "type": "string"
                  },
                  "produtoId": {
                    "type": "string"
                  },
                  "quantidade": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "unidadeId",
                  "produtoId",
                  "quantidade"
                ]
              },
              "example": {
                "unidadeId": "33333333-3333-4333-8333-333333333333",
                "produtoId": "44444444-4444-4444-8444-444444444444",
                "quantidade": 20
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Entrada registrada",
            "content": {
              "application/json": {
                "example": {
                  "msg": "Entrada de estoque registrada.",
                  "estoque": {
                    "id": "77777777-7777-4777-8777-777777777777",
                    "unidadeId": "33333333-3333-4333-8333-333333333333",
                    "produtoId": "44444444-4444-4444-8444-444444444444",
                    "quantidade": 70
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token não informado.",
            "content": {
              "application/json": {
                "example": {
                  "error": "NAO_AUTENTICADO",
                  "message": "Token não informado.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/estoque"
                }
              }
            }
          },
          "403": {
            "description": "Seu perfil não tem acesso a este recurso.",
            "content": {
              "application/json": {
                "example": {
                  "error": "SEM_PERMISSAO",
                  "message": "Seu perfil não tem acesso a este recurso.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/estoque"
                }
              }
            }
          },
          "404": {
            "description": "Unidade ou produto não encontrado",
            "content": {
              "application/json": {
                "examples": {
                  "unidade": {
                    "summary": "Unidade inexistente",
                    "value": {
                      "error": "UNIDADE_NAO_ENCONTRADA",
                      "message": "Unidade informada não existe.",
                      "details": [],
                      "timestamp": "2026-11-21T12:00:00.000Z",
                      "path": "/estoque"
                    }
                  },
                  "produto": {
                    "summary": "Produto inexistente",
                    "value": {
                      "error": "PRODUTO_NAO_ENCONTRADO",
                      "message": "Produto não encontrado.",
                      "details": [],
                      "timestamp": "2026-11-21T12:00:00.000Z",
                      "path": "/estoque"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Dados da entrada inválidos",
            "content": {
              "application/json": {
                "examples": {
                  "camposObrigatorios": {
                    "summary": "Campo ausente",
                    "value": {
                      "error": "CAMPOS_OBRIGATORIOS",
                      "message": "Informe a unidade e o produto da entrada de estoque.",
                      "details": [
                        {
                          "field": "unidadeId",
                          "issue": "Campo obrigatório"
                        }
                      ],
                      "timestamp": "2026-11-21T12:00:00.000Z",
                      "path": "/estoque"
                    }
                  },
                  "quantidadeInvalida": {
                    "summary": "Quantidade inválida",
                    "value": {
                      "error": "QUANTIDADE_INVALIDA",
                      "message": "A quantidade da entrada precisa ser um número inteiro maior que zero.",
                      "details": [
                        {
                          "field": "quantidade",
                          "issue": "Use um número inteiro maior que zero"
                        }
                      ],
                      "timestamp": "2026-11-21T12:00:00.000Z",
                      "path": "/estoque"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro ao registrar entrada de estoque.",
            "content": {
              "application/json": {
                "example": {
                  "error": "ERRO_INTERNO",
                  "message": "Erro ao registrar entrada de estoque.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/estoque"
                }
              }
            }
          }
        }
      }
    },
