      }
    },
    "/pedidos": {
      "post": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Criar pedido",
        "description": "Exige JWT e canalPedido válido. O pedido é criado em AGUARDANDO_PAGAMENTO. Valida estoque e recusa produtos duplicados entre os itens.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "unidadeId": {
                    "type": "string"
                  },
                  "canalPedido": {
                    "type": "string",
                    "enum": [
                      "APP",
                      "TOTEM",
                      "BALCAO",
                      "PICKUP",
                      "WEB"
                    ]
                  },
                  "formaPagamento": {
                    "type": "string"
                  },
                  "itens": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "produtoId": {
                          "type": "string"
                        },
                        "quantidade": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
