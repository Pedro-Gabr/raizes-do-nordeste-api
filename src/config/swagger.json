              "application/json": {
                "example": {
                  "error": "NAO_AUTENTICADO",
                  "message": "Token não informado.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/estoque/33333333-3333-4333-8333-333333333333"
                }
              }
            }
          },
          "500": {
            "description": "Erro ao consultar estoque.",
            "content": {
              "application/json": {
                "example": {
                  "error": "ERRO_INTERNO",
                  "message": "Erro ao consultar estoque.",
                  "details": [],
                  "timestamp": "2026-11-21T12:00:00.000Z",
                  "path": "/estoque/33333333-3333-4333-8333-333333333333"
                }
              }
            }
          }
        }
      }
    },
    "/fidelidade/saldo": {
      "get": {
        "tags": [
          "Fidelidade"
