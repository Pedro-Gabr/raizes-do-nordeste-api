digraph classes {
  rankdir=LR; nodesep=0.55; ranksep=1.5; splines=true; fontname="Arial";
  node [shape=plaintext, fontname="Arial", fontsize=12];
  edge [fontname="Arial", fontsize=11, color="#374151", arrowsize=0.8, labeldistance=2.2, labelangle=25];
  Usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6b7280"><TR><TD BGCOLOR="#fff7e6" ALIGN="CENTER"><B>Usuario</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nome : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- email : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- senha : String (hash)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- role : Perfil</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- pontos : Int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- consentimentoLGPD : Boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- consentimentoEm : DateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- anonimizadoEm : DateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- criadoEm : DateTime</TD></TR></TABLE>>];
  Unidade [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6b7280"><TR><TD BGCOLOR="#fff7e6" ALIGN="CENTER"><B>Unidade</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nome : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- endereco : String</TD></TR></TABLE>>];
  Produto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6b7280"><TR><TD BGCOLOR="#fff7e6" ALIGN="CENTER"><B>Produto</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nome : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- preco : Float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- descricao : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- disponivel : Boolean</TD></TR></TABLE>>];
  Estoque [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6b7280"><TR><TD BGCOLOR="#fff7e6" ALIGN="CENTER"><B>Estoque</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- quantidade : Int</TD></TR></TABLE>>];
  Pedido [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6b7280"><TR><TD BGCOLOR="#fff7e6" ALIGN="CENTER"><B>Pedido</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- canalPedido : CanalPedido</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- formaPagamento : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- status : StatusPedido</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- total : Float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- pontosUsados : Int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- desconto : Float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- criadoEm : DateTime</TD></TR></TABLE>>];
  ItemPedido [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6b7280"><TR><TD BGCOLOR="#fff7e6" ALIGN="CENTER"><B>ItemPedido</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- quantidade : Int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- precoUnitario : Float</TD></TR></TABLE>>];
  Pagamento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6b7280"><TR><TD BGCOLOR="#fff7e6" ALIGN="CENTER"><B>Pagamento</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- status : String (APROVADO | RECUSADO)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- transacaoId : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- valor : Float</TD></TR></TABLE>>];
  MovimentoPontos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6b7280"><TR><TD BGCOLOR="#fff7e6" ALIGN="CENTER"><B>MovimentoPontos</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- tipo : String (ACUMULO | RESGATE | ESTORNO)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- pontos : Int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- criadoEm : DateTime</TD></TR></TABLE>>];
  LogAuditoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6b7280"><TR><TD BGCOLOR="#fff7e6" ALIGN="CENTER"><B>LogAuditoria</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- acao : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- entidade : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- entidadeId : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- detalhes : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- criadoEm : DateTime</TD></TR></TABLE>>];
  Perfil [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6b7280"><TR><TD BGCOLOR="#e6f0fa" ALIGN="CENTER">«enumeration»<BR/><B>Perfil</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">CLIENTE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ATENDENTE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">COZINHA</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">GERENTE</TD></TR></TABLE>>];
  StatusPedido [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6b7280"><TR><TD BGCOLOR="#e6f0fa" ALIGN="CENTER">«enumeration»<BR/><B>StatusPedido</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">AGUARDANDO_PAGAMENTO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PAGO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">EM_PREPARO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PRONTO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ENTREGUE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CANCELADO</TD></TR></TABLE>>];
  CanalPedido [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6b7280"><TR><TD BGCOLOR="#e6f0fa" ALIGN="CENTER">«enumeration»<BR/><B>CanalPedido</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">APP</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">TOTEM</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">BALCAO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PICKUP</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">WEB</TD></TR></TABLE>>];
  Usuario -> Pedido [label="faz", taillabel="1", headlabel="0..*", arrowhead=vee];
  Unidade -> Pedido [label="recebe", taillabel="1", headlabel="0..*", arrowhead=vee];
  Unidade -> Estoque [label="possui", taillabel="1", headlabel="0..*", arrowhead=vee];
  Produto -> Estoque [label="tem saldo em", taillabel="1", headlabel="0..*", arrowhead=vee];
  Pedido -> ItemPedido [label="é composto por", taillabel="1", headlabel="1..*", arrowtail=diamond, dir=both, arrowhead=vee];
  Produto -> ItemPedido [label="aparece em", taillabel="1", headlabel="0..*", arrowhead=vee];
  Pedido -> Pagamento [label="tem", taillabel="1", headlabel="0..1", arrowhead=vee];
  Usuario -> MovimentoPontos [label="acumula e resgata", taillabel="1", headlabel="0..*", arrowhead=vee];
  Pedido -> MovimentoPontos [label="origina", taillabel="0..1", headlabel="0..*", arrowhead=vee];
  Usuario -> LogAuditoria [label="gera", taillabel="0..1", headlabel="0..*", arrowhead=vee];
  { rank=sink; Perfil; StatusPedido; CanalPedido; }
}