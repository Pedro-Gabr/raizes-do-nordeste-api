generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  role      String   @default("CLIENTE") 
  pontos    Int      @default(0) 
  consentimentoLGPD Boolean @default(false) 
  pedidos   Pedido[]
  criadoEm  DateTime @default(now())
}

model Unidade {
  id       String    @id @default(uuid())
  nome     String
  endereco String
  estoques Estoque[]
  pedidos  Pedido[]
}

model Produto {
  id          String    @id @default(uuid())
  nome        String
  preco       Float
  descricao   String?
  disponivel  Boolean   @default(true) 
  estoques    Estoque[]
  itensPedido ItemPedido[]
}

model Estoque {
  id          String  @id @default(uuid())
  unidadeId   String
  produtoId   String
  quantidade  Int     @default(0)

  unidade Unidade @relation(fields: [unidadeId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@unique([unidadeId, produtoId]) 
}

model Pedido {
  id          String   @id @default(uuid())
  clienteId   String
  unidadeId   String
  status      String   @default("PENDENTE") 
  total       Float
  criadoEm    DateTime @default(now())

  cliente Usuario     @relation(fields: [clienteId], references: [id])
  unidade Unidade     @relation(fields: [unidadeId], references: [id])
  itens   ItemPedido[]
  pagamento Pagamento?
}

model ItemPedido {
  id        String  @id @default(uuid())
  pedidoId  String
  produtoId String
  quantidade Int
  precoUnitario Float 

  pedido  Pedido  @relation(fields: [pedidoId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])
}

model Pagamento {
  id             String  @id @default(uuid())
  pedidoId       String  @unique
  status         String  
  transacaoId    String? 
  valor          Float
  
  pedido Pedido @relation(fields: [pedidoId], references: [id])
}